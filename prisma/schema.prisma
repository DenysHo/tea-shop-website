generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tea {
  id               String   @id @default(cuid())
  slug             String   @unique
  teaType          String
  harvest          String
  caffeineLevel    String
  accentColor      String
  featured         Boolean  @default(false)
  name             Json
  shortDescription Json
  description      Json
  origin           Json
  flavorNotes      Json
  legalName        Json     @default("{}")
  ingredients      Json     @default("{}")
  allergens        Json     @default("{}")
  images           String[]
  priceCents       Int @default(0)
  saleUnitGrams    Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TeaWare {
  id               String   @id @default(cuid())
  slug             String   @unique
  teaWareType      String
  accentColor      String
  featured         Boolean  @default(false)
  name             Json
  shortDescription Json
  description      Json
  material         Json
  origin           Json
  craftsman        Json?
  capacityMl       Int?
  manufacturer     String   @default("")
  manufacturerContact String @default("")
  itemNumber       String   @default("")
  warnings         Json     @default("{}")
  images           String[]
  priceCents       Int @default(0)
  pieceCount       Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  ip          String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  email        String
  phone        String?
  country      String
  postalCode   String
  city         String
  street       String
  houseNumber  String
  note         String?
  items        Json
  totalCents   Int
  status       OrderStatus @default(NEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}