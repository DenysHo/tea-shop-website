# postgresql://user:password@localhost:5432/zentee?schema=public
DATABASE_URL="postgresql://zentee:zentee@localhost:5432/zentee"

# Random string, 32+ characters, used to encrypt the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string-min-32-chars"

# Used only by `npm run db:seed` to create the first admin account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

NEXT_PUBLIC_R2_PUBLIC_URL=to befilled

R2_ACCOUNT_ID=to befilled
R2_ENDPOINT=to befilled
R2_BUCKET_NAME=to befilled
R2_ACCESS_KEY_ID=to befilled
R2_SECRET_ACCESS_KEY=to befilled

INSTAGRAM_TOKEN=to befilled